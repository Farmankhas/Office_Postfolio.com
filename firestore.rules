rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core authentication and authorization helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)
      );
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Published Portfolio Content
    // Public visitors have READ-ONLY access
    // Only authenticated and authorized administrators can CREATE, UPDATE, or DELETE
    match /portfolio/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(docId) && isAdmin();
    }

    // 2. Media and Image Assets
    // Public visitors can view published images
    // Only authenticated administrators can upload, replace, or delete
    match /media/{mediaId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(mediaId) && isAdmin();
    }

    // 3. Administrator Role Registry
    // Authenticated users can check their own admin status; list is admin-only
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
